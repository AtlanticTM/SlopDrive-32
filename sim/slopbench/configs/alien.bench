# alien.bench — a conformant hub that shares NOTHING with SlopDrive-32's own
# allocation. Every device-range id below sits in a RESERVED domain nibble
# (docs/slopsync/CHANNEL-MAP.md: 3=auxiliary, 4=playback, 5=automation,
# 8-F=parked for multi-axis) that the real device never allocates, per the
# 0xCDSS grid (class nibble 1=STATE/2=STREAM/3=INTENT/4=EVENT/5=STORE). A
# client that hardcoded SlopDrive-32's channel ids anywhere breaks visibly
# against this hub.

hub
  name alien-rig
  product AlienRig
  fw_version 0.9.0-alien
  echo_delay_ms 0

# 0x1300 = STATE(1) . auxiliary(3) . slot 00
state 0x1300 aux-state
  category auxiliary
  rate_hz 5
  field heat_pct f32 % 0 100
  field lube_pct f32 % 0 100

# 0x3300 = INTENT(3) . auxiliary(3) . slot 00 -- writes 0x1300
intent 0x3300 aux-set
  writes 0x1300
  access control
  echo_delay_ms 400
  field heat_pct f32 % 0 100 key=1
  field lube_pct f32 % 0 100 key=2

# 0x4400 = EVENT(4) . playback(4) . slot 00 -- declared only, no traffic
event 0x4400 playback-events
  category playback
  field kind uint - key=1
  field track uint - key=2

# 0x5500 = STORE(5) . automation(5) . slot 00 -- declared only, always NACKs
# BLOB_REQ (no backend wired; see README "cut for leanness").
store 0x5500 automation-library
  category automation
  kind automation.routine
  capacity 8
  per_item_max 512
  name_max 32

# 0x2800 = STREAM(2) . domain 8 (parked for multi-axis) . slot 00 -- declared
# only, no ingestion wired.
stream 0x2800 axis8-stream
  category hardware
  rate_hz 50
